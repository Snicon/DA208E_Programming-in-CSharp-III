@page
@model DA208E_Assignment1.Pages.Gallery

@{
    ViewData["Title"] = "Gallery";
}

<div class="text-center">
    <h1 class="display-4 emphasis mb-5">Photo gallery</h1>
    <section class="row">
        <div class="col">
            <div class="card img-card">
                <img src="~/img/kiss.jpg" class="card-img-top" alt="The couple kissing on a rock surrounded by water">
                <div class="card-body">
                    <p class="card-text">The couple sharing a romantic kiss together.</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card img-card">
                <img src="~/img/venue.jpg" class="card-img-top" alt="The wedding venue">
                <div class="card-body">
                    <p class="card-text">The wedding venue before all guests arrived.</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card img-card">
                <img src="~/img/table.jpg" class="card-img-top" alt="The wedding venue">
                <div class="card-body">
                    <p class="card-text">The table set and ready to serve some great food.</p>
                </div>
            </div>
        </div>
    </section>
</div>