@model NavItemModel;

@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString().ToLower();
    var targetPage = Model.Page.ToLower().TrimEnd('/');
    var isActive = currentPage == targetPage || currentPage == targetPage + "/index";
}

<li class="nav-item">
    <a asp-page="@Model.Page" class="nav-link @(isActive ? "active" : "")" asp-area="">
        @Model.Label
    </a>
</li>