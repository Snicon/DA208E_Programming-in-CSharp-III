@model Guest

@{
    ViewData["Title"] = "Viewing guest details";
}

<div class="text-center container">
    <h1 class="display-4 emphasis">@ViewData["Title"] (@Model.Name)</h1>

    <div>
        <p class="card-text">
            Guest data
        </p>
        <dl>
            <dt>Name</dt>
            <dd>@Model.Name</dd>
                    
            <dt>Email</dt>
            <dd>@Model.Email</dd>
                    
            <dt>Phone number</dt>
            <dd>@Model.PhoneNumber</dd>
                    
            <dt>Attending</dt>
            @switch (Model.Attending)
            {
                case true:
                    <dd>Yes</dd>
                    break;
                case false:
                    <dd>No</dd>
                    break;
                default:
                    <dd>Awaiting RSVP</dd>
                    break;
            }
                    
            <dt>Message</dt>
            <dd>@Model.Message</dd>
        </dl>
    </div>
</div>