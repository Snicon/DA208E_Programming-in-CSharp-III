@model UsefulInformation

@{
    ViewData["Title"] = "Edit useful information entry";
}

<div class="text-center container">
    <h1 class="display-4 emphasis">@ViewData["Title"]</h1>

    <!-- Event creation form below -->
    <form asp-action="EditUsefulInformation" class="text-start">
        <input type="hidden" asp-for="@Model.Id" />
        <fieldset>
            <legend>Edit useful information entry</legend>
            <div class="mb-3">
                <label asp-for="Icon" class="form-label">Icon</label>
                <select asp-for="Icon" class="form-control" aria-describedby="iconHelpBlock">
                    <option value="hotel.svg">Hotel</option>
                    <option value="suit.svg">Suit</option>
                    <option value="bottle.svg">Bottle</option>
                    <option value="car.svg">Car</option>
                </select>
                <span asp-validation-for="Icon" class="text-danger"></span>
                <div id="iconHelpBlock" class="form-text">
                    An icon representing the information.
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" aria-describedby="titleHelpBlock">
                <span asp-validation-for="Title" class="text-danger"></span>
                <div id="titleHelpBlock" class="form-text">
                    The title. Must be at least 3 characters long and may not be longer than 30 characters.
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <input asp-for="Description" class="form-control" aria-describedby="descriptionNumberHelpBlock">
                <span asp-validation-for="Description" class="text-danger"></span>
                <div id="descriptionHelpBlock" class="form-text">
                    Description, detailing the information, may not be shorter than 20 characters or longer than 150 characters.
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Save changes to useful information data</button>
        </fieldset>
    </form>
</div>