@model List<Event>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="text-center container">
    <div>
        <h1 class="display-4 emphasis">@ViewData["Title"]</h1>
    </div>

    <h2 class="mt-5">All events</h2>
    @if (Model.Count == 0)
    {
        <p>No events exist, <a asp-controller="Event" asp-action="Create">would you like to create an event</a>?</p>
    }
    else
    {
        <table class="table table-striped text-start">
            <thead>
            <tr>
                <th scope="col">Title</th>
                <th scope="col">DateTime</th>
                <th scope="col">Description</th>
                <th scope="col">Actions</th>
            </tr>
            </thead>
            <tbody>

            @foreach (var theEvent in Model)
            {
                <tr>
                    <td>@theEvent.Title</td>
                    <td>@theEvent.DateTime</td>
                    <td>@theEvent.Description</td>
                    <td>
                        <a asp-controller="Event" asp-action="Details" asp-route-id="@theEvent.Id" class="btn btn-sm btn-success">View details</a>
                        <a asp-controller="Event" asp-action="Edit" asp-route-id="@theEvent.Id" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-controller="Event" asp-action="Delete" asp-route-id="@theEvent.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
            <caption>Total events: @Model.Count</caption>
        </table>
    }
</div>