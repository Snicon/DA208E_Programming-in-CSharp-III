<!-- Very simple partial used for the navbar to clean up the _Layout.cshtml file -->
<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-5">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">Wedding App MVC</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
            <ul class="navbar-nav flex-grow-1">
                <!-- Using the NavItem partial to display all nav items -->
                @await Html.PartialAsync("_NavItem", new NavItemModel("Home", "Index", "Home"))
                @await Html.PartialAsync("_NavItem", new NavItemModel("Event", "Index", "Event"))
                @await Html.PartialAsync("_NavItem", new NavItemModel("Guest", "Create", "Register guest"))
                @await Html.PartialAsync("_NavItem", new NavItemModel("Guest", "Index", "Guest list"))
                @await Html.PartialAsync("_NavItem", new NavItemModel("Dashboard", "Index", "Dashboard"))
                @if (User.Identity!.IsAuthenticated)
                {
                    <li class="nav-item">
                        <a asp-area="Identity" asp-page="/Account/Manage/Index" class="nav-link">
                            My Account
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Identity" asp-page="/Account/Logout" class="nav-link">
                            Logout
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a asp-area="Identity" asp-page="/Account/Register" class="nav-link">
                            Register
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Identity" asp-page="/Account/Login" class="nav-link">
                            Login
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>