@page
@using DA208E_Assignment1.Models
@model DA208E_Assignment1.Pages.Guests.Index

@{
    ViewData["Title"] = "Guests";
}

<div class="text-center">
    <h1 class="display-4 emphasis">@ViewData["Title"]</h1>
    <p>View and manage the guest list below.</p>
    
    @if (Model.Guests.Count == 0)
    {
        <p>I'm sorry to say that your event doesn't seem quite popular (yet!), there are no guest RSVPs registered yet.</p>
    }
    else
    {
        <table class="table table-striped text-start">
            <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Email</th>
                <th scope="col">Attending</th>
                <th scope="col">Message</th>
                <th scope="col">Actions</th>
            </tr>
            </thead>
            <tbody>

            @foreach (var guest in Model.Guests)
            {
                <tr>
                    <td>@guest.Name</td>
                    <td>@guest.Email</td>
                    <td>
                        @if (guest.Attending)
                        {
                            <span>Yes</span>
                        }
                        else
                        {
                            <span>No</span>
                        }
                    </td>
                    <td>@guest.Message</td>
                    <td>
                        <a asp-page="Edit" asp-route-id="@guest.Id" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-page="Delete" asp-route-id="@guest.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
            <caption>Total Guests: @Model.Guests.Count</caption>
        </table>
    }
</div>