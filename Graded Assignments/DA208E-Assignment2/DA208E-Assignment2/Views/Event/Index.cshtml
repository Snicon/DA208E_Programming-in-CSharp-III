@model List<Event>

@{
    ViewData["Title"] = "Event";
}

<div class="text-center container">
    <div>
        <h1 class="display-4 emphasis">Event information</h1>
        <p>Welcome to <em>John & Jane's Wedding</em> at Springfield Wedding Hall, Lund, Sweden, <time class="fw-bold" datetime="2026-10-12T15:00">2026-10-12. (15:00)</time>.</p>
    </div>
    
    <!-- Heavily inspired by this codepen: https://codepen.io/funkwarrior/pen/BamYMZE -->
    <div class="py-2 schedule">
        <h2 class="mb-5">Event schedule</h2>
        
        @if (Model.Count > 0)
        {
            @for (int i = 0; i < Model.Count; i++)
            {
                var theEvent = Model[i];
                var isLeft = i % 2 == 0; // Used to alternate between left/right side
                var isFirst = i == 0;
                var isLast = i == Model.Count - 1;
                
                <div class="row no-gutters">
                    @if (isLeft)
                    {
                        <!-- Event card (left) -->
                        <div class="col-sm py-2">
                            <div class="standout card shadow">
                                <div class="card-body">
                                    <h4 class="card-title m-0">
                                        @theEvent.Title
                                    </h4>
                                    <div class="float-right text-muted small mb-2">
                                        @theEvent.DateTime.ToString("HH:mm")
                                    </div>
                                    <p class="card-text">@theEvent.Description</p>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="col-lg"><!-- Empty col on left side for spacing --></div>
                    }
                    
                    <!-- Marker in middle -->
                    <div class="col-sm-1 text-center flex-column d-none d-lg-flex">
                        <!-- Line above -->
                        <div class="row h-50">
                            @if (isFirst)
                            {
                                <div class="col">&nbsp;</div>
                                <div class="col">&nbsp;</div>
                            }
                            else
                            {
                                <div class="col border-end">&nbsp;</div>
                                <div class="col">&nbsp;</div>
                            }
                        </div>
                        
                        <!-- Circle/Marker -->
                        <h5 class="m-2">
                            <span class="rounded-circle badge bg-light border">&nbsp;</span>
                        </h5>
                        
                        <!-- Line below -->
                        <div class="row h-50">
                            @if (isLast)
                            {
                                <div class="col">&nbsp;</div>
                                <div class="col">&nbsp;</div>
                            }
                            else
                            {
                                <div class="col border-end">&nbsp;</div>
                                <div class="col">&nbsp;</div>
                            }
                        </div>
                    </div>
                    
                    @if (isLeft)
                    {
                        <div class="col-lg"><!-- Empty col on right side for spacing --></div>
                    } else {
                        <!-- Event card (right) -->
                        <div class="col-sm py-2">
                            <div class="standout card shadow">
                                <div class="card-body">
                                    <h4 class="card-title m-0">
                                        @theEvent.Title
                                    </h4>
                                    <div class="float-right text-muted small mb-2">
                                        @theEvent.DateTime.ToString("HH:mm")
                                    </div>
                                    <p class="card-text">@theEvent.Description</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <p class="text-muted">No events scheduled, please inform the hosts.</p>
        }
    </div>
</div>

<section class="text-center mb-5">
    <h2>Will you be joining us?</h2>
    <p>
        Please let us know by <time datetime="2026-09-12">2026-09-12</time>. We hope you can make it!
    </p>
    <ol class="mx-auto list-unstyled">
        <li><a asp-controller="Guest" asp-action="Create">Register yourself as a guest</a></li>
        <li><a asp-controller="Guest" asp-action="Index">Enter the RSVP form from the guest list</a></li>    
    </ol>
</section>