@page
@model DA208E_Assignment1.Pages.Guests.Confirmation

@{
    ViewData["Title"] = "Confirmation";
}

<div class="text-center">
    <h1 class="display-4 emphasis">Participation confirmed!</h1>
    <p>We look forward to sharing our big day with you!</p>
    
    <h2 class="mt-5">To sum it all up:</h2>
    <p>Welcome to <em>@Model.EventInfo.Title</em> at @Model.EventInfo.Location, <time class="fw-bold" datetime="2026-10-12T15:00">@Model.EventInfo.Date (@Model.EventInfo.Time)</time>.</p>
</div>